import { Button, ComboBox, LineEdit, ProgressIndicator, ScrollView, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { WarmTheme } from "../theme.slint";
import { AppState } from "../store.slint";
import { MdView } from "md.slint";

// Session view: bubble list (user right / assistant left), per-message token
// footnote, streaming cursor while `sending`, composer with model picker,
// context-usage bar + cost label, welcome hero on empty threads.
export component ChatView inherits Rectangle {
    background: transparent;

    VerticalBox {
        padding: 12px;
        spacing: WarmTheme.gap;

        hero := Rectangle {
            visible: AppState.messages.length == 0 && !AppState.sending;
            VerticalBox {
                alignment: LayoutAlignment.center;
                spacing: 6px;
                Text {
                    text: "computerAgent";
                    color: WarmTheme.brand;
                    font-size: 28px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Warm hands, full privileges. Ask, then Enter.";
                    color: WarmTheme.muted;
                    font-size: WarmTheme.font-body;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Ctrl+N new · Ctrl+H history · Ctrl+D model · Ctrl+S stop";
                    color: WarmTheme.muted;
                    font-size: WarmTheme.font-small;
                    horizontal-alignment: center;
                }
            }
        }

        feed := ScrollView {
            vertical-stretch: 1;
            VerticalBox {
                alignment: LayoutAlignment.start;
                spacing: WarmTheme.gap;
                for msg in AppState.messages: HorizontalBox {
                    alignment: msg.role == "user" ? LayoutAlignment.end : LayoutAlignment.start;
                    // Deterministic column width: wrapped Text measures its
                    // height against this, so rows stack instead of stretching
                    // or overflowing each other.
                    Rectangle {
                        width: msg.role == "user" ? Math.min(560px, root.width * 0.72) : Math.min(780px, root.width * 0.9);
                        background: msg.role == "user" ? WarmTheme.user-bubble : WarmTheme.ai-bubble;
                        border-radius: WarmTheme.radius;
                        VerticalBox {
                            alignment: LayoutAlignment.start;
                            padding: 10px;
                            spacing: 4px;
                            MdView {
                                blocks: msg.blocks;
                                inverted: msg.role == "user";
                            }
                            Text {
                                text: msg.tokens;
                                color: msg.role == "user" ? WarmTheme.user-text : WarmTheme.muted;
                                font-size: WarmTheme.font-small;
                            }
                        }
                    }
                }
                Rectangle {
                    visible: AppState.sending;
                    Text {
                        text: "▍ thinking…";
                        color: WarmTheme.amber;
                        font-size: WarmTheme.font-body;
                    }
                }
            }
        }

        usage := HorizontalBox {
            spacing: 8px;
            Text {
                text: "Context";
                color: WarmTheme.muted;
                font-size: WarmTheme.font-small;
                vertical-alignment: center;
            }
            ProgressIndicator {
                horizontal-stretch: 1;
                progress: AppState.ctx-window > 0 ? 1.0 * AppState.ctx-used / AppState.ctx-window : 0.0;
            }
            Text {
                text: AppState.ctx-label;
                color: WarmTheme.muted;
                font-size: WarmTheme.font-small;
                vertical-alignment: center;
            }
            Text {
                text: AppState.cost-label;
                color: WarmTheme.amber;
                font-size: WarmTheme.font-small;
                vertical-alignment: center;
            }
        }

        // Run banner: errors surface here, large, instead of hiding in
        // the status bar. Visible only for failed runs.
        banner := Rectangle {
            visible: !AppState.status-ok;
            background: #F7E3DF;
            border-radius: 8px;
            border-width: 1px;
            border-color: WarmTheme.danger;
            HorizontalBox {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: "⚠";
                    color: WarmTheme.danger;
                    font-size: 16px;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: AppState.status-text;
                    color: WarmTheme.danger;
                    font-size: WarmTheme.font-small;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }

        composer := HorizontalBox {
            spacing: WarmTheme.gap;
            model-picker := ComboBox {
                max-width: 220px;
                model: AppState.models;
                // One-way: user picks fire `selected`; programmatic writes
                // back only warn (Slint tracks the widget's own choice).
                // The status bar always shows the effective model.
                current-value: AppState.current-model;
                selected(value) => { AppState.set-model(value); }
            }
            // TextInput is a bare editor (no border/background), so it
            // needs an explicit frame or it is invisible when empty.
            frame := Rectangle {
                horizontal-stretch: 1;
                min-height: 84px;
                background: WarmTheme.surface;
                border-width: 1px;
                border-color: WarmTheme.border;
                border-radius: 8px;
                VerticalBox {
                    padding: 8px;
                    input := TextInput {
                        vertical-stretch: 1;
                        font-size: WarmTheme.font-body;
                        color: WarmTheme.text;
                        wrap: word-wrap;
                        text <=> AppState.draft;
                        enabled: !AppState.sending;
                        key-pressed(event) => {
                            // Enter sends; Shift+Enter keeps a newline.
                            if (event.text == Key.Return && !event.modifiers.shift) {
                                if (AppState.draft != "") {
                                    AppState.send-message(AppState.draft);
                                }
                                return accept;
                            }
                            return reject;
                        }
                    }
                }
            }
            // Primary send: custom so it stays readable on paper in both
            // schemes (std Button follows Palette and washes out).
            send := Rectangle {
                width: 92px;
                height: 84px;
                background: (ta.has-hover && send-enabled) ? WarmTheme.amber : WarmTheme.brand;
                opacity: send-enabled ? 1.0 : 0.45;
                border-radius: WarmTheme.radius;
                property <bool> send-enabled: !AppState.sending && AppState.draft != "";

                Text {
                    text: "Send ➤";
                    color: WarmTheme.user-text;
                    font-size: WarmTheme.font-body;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                ta := TouchArea {
                    enabled: send-enabled;
                    mouse-cursor: pointer;
                    clicked => { AppState.send-message(AppState.draft); }
                }
            }
            Button {
                visible: AppState.sending;
                text: "Stop";
                clicked => { AppState.stop-run(); }
            }
        }
    }
}
