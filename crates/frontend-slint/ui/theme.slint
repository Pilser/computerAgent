// Warm paper theme: terracotta brand + amber accent on paper (light) or
// ember brown (dark). Slots below are reactive: flipping `dark` repaints
// every view with no Rust involvement. Deliberately different from
// flymoon's blue; markdown theming arrives with the markdown milestone.
//
// Every slot is `in-out`: globals default to private, and views in other
// files may only read annotated properties.

export global WarmTheme {
    in-out property <bool> dark: false;

    in-out property <color> bg: dark ? #211A13 : #FAF5EC;
    in-out property <color> surface: dark ? #2C231A : #FFFDF8;
    in-out property <color> border: dark ? #4A3A2B : #E7DAC3;
    in-out property <color> text: dark ? #F2E8D8 : #2E2620;
    in-out property <color> muted: dark ? #A89880 : #8A7A66;
    in-out property <color> brand: dark ? #D97B45 : #C4622D;
    in-out property <color> amber: dark ? #D9A845 : #B98A2F;
    in-out property <color> user-bubble: #C4622D;
    in-out property <color> user-text: #FFF8EF;
    in-out property <color> ai-bubble: dark ? #3A2E22 : #F1E7D3;
    in-out property <color> danger: dark ? #D96A5E : #B3362B;

    in-out property <length> radius: 10px;
    in-out property <length> gap: 8px;
    in-out property <length> font-body: 14px;
    in-out property <length> font-small: 12px;
    in-out property <length> font-title: 18px;
}
