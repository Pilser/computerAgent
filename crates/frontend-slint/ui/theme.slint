// Warm paper theme: terracotta brand + amber accent on paper (light) or
// ember brown (dark). Slots below are reactive: flipping `dark` repaints
// every view with no Rust involvement. Deliberately different from
// flymoon's blue; markdown theming arrives with the markdown milestone.

export global WarmTheme {
    in-out property <bool> dark: false;

    property <color> bg: dark ? #211A13 : #FAF5EC;
    property <color> surface: dark ? #2C231A : #FFFDF8;
    property <color> border: dark ? #4A3A2B : #E7DAC3;
    property <color> text: dark ? #F2E8D8 : #2E2620;
    property <color> muted: dark ? #A89880 : #8A7A66;
    property <color> brand: dark ? #D97B45 : #C4622D;
    property <color> amber: dark ? #D9A845 : #B98A2F;
    property <color> user-bubble: #C4622D;
    property <color> user-text: #FFF8EF;
    property <color> ai-bubble: dark ? #3A2E22 : #F1E7D3;
    property <color> danger: dark ? #D96A5E : #B3362B;

    property <length> radius: 10px;
    property <length> gap: 8px;
    property <length> font-body: 14px;
    property <length> font-small: 12px;
    property <length> font-title: 18px;
}
